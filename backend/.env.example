# Gemini API Key - Get it from https://ai.google.dev/aistudio
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API key POOL - add as many free-tier keys as you like (comma-separated).
# Each key gets its own daily quota; the backend rotates automatically.
# e.g. 4 keys x 20 requests/day = ~80 tailored resumes per day.
GEMINI_API_KEYS=key_one,key_two,key_three,key_four
# Soft per-key daily cap (free tier is ~20 requests/day/key for flash models)
GEMINI_DAILY_LIMIT_PER_KEY=20

# Supabase (per-user resume history, auto-deleted after RESUME_TTL_HOURS).
# Project Settings -> API. Leave empty to use the local ./resumes folder instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resumes
RESUME_TTL_HOURS=24

# Backend server config (optional)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend config
FRONTEND_URL=http://localhost:3000
