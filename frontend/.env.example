# Public URL of the FastAPI backend (no trailing slash).
# Local dev:   http://localhost:8000
# Production:  https://resume-tailor-api.onrender.com  (set this in Vercel env vars)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase (Project Settings -> API). Leave both empty for local single-user mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
